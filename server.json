{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.SilverNine/trimscript",
  "title": "TrimScript",
  "description": "Edit video by editing the transcript. Runs locally; agent edits arrive as suggestions you approve.",
  "repository": {
    "url": "https://github.com/SilverNine/trimscript",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "trimscript",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
